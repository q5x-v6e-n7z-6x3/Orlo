%YAML 1.2
---
name: HolyC
# .HH is handled case-sensitively by detection to preserve C++'s .hh extension.
file_extensions: [hc]
scope: source.holyc
contexts:
  main:
    - include: comments
    - include: strings
    - match: '#\s*(?:include|define|undef|if|ifdef|ifndef|else|elif|endif|assert|exe|help_index|help_file)\b'
      scope: keyword.control.import.holyc
    - match: '\b(?:Bool|[IU](?:0|8|16|32|64)i?|F64i?)\b'
      scope: storage.type.holyc
    - match: '\b(?:class|union)\b'
      scope: storage.type.holyc
    - match: '\b(?:public|extern|_extern|import|_import|static|reg|noreg|interrupt|haserrcode|argpop|noargpop)\b'
      scope: storage.modifier.holyc
    - match: '\b(?:if|else|switch|case|default|start|end|for|while|do|break|goto|return|try|catch|asm|lock|no_warn)\b'
      scope: keyword.control.holyc
    - match: '\b(?:sizeof|offset|lastclass)\b'
      scope: keyword.operator.holyc
    - match: '\b(?:TRUE|FALSE|NULL|ON|OFF)\b'
      scope: constant.language.holyc
    - match: '\b0[xX][0-9A-Fa-f]+\b|\b0[bB][01]+\b|(?:\b[0-9]+(?:\.(?!\.)[0-9]*)?|\B\.[0-9]+)(?:[eE][+-]?[0-9]+)?'
      scope: constant.numeric.holyc
    - match: '\b[A-Za-z_][A-Za-z_0-9]*(?=\s*\()'
      scope: entity.name.function.holyc
    - match: '\b[A-Za-z_][A-Za-z_0-9]*\b'
      scope: variable.other.holyc
    - match: '\.\.\.|[+*/%=!<>|&^~`$-]'
      scope: keyword.operator.holyc
    - match: '[{}()\[\]]'
      scope: punctuation.section.holyc
    - match: '[;,:.]'
      scope: punctuation.separator.holyc

  comments:
    - match: '//'
      scope: punctuation.definition.comment.holyc
      push:
        - meta_scope: comment.line.double-slash.holyc
        - match: $\n?
          pop: true
    - match: '/\*'
      scope: punctuation.definition.comment.begin.holyc
      push:
        - meta_scope: comment.block.holyc
        - match: '\*/'
          scope: punctuation.definition.comment.end.holyc
          pop: true

  strings:
    - match: '"'
      scope: punctuation.definition.string.begin.holyc
      push:
        - meta_scope: string.quoted.double.holyc
        - include: escapes
        - match: '"'
          scope: punctuation.definition.string.end.holyc
          pop: true
    - match: "'"
      scope: punctuation.definition.string.begin.holyc
      push:
        - meta_scope: string.quoted.single.holyc
        - include: escapes
        - match: "'"
          scope: punctuation.definition.string.end.holyc
          pop: true

  escapes:
    - match: '\\(?:[0-7]{1,3}|x[0-9A-Fa-f]+|.)|\$\$'
      scope: constant.character.escape.holyc
