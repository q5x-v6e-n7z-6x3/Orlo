{
  "schema": 1,
  "id": "cpp",
  "name": "C++",
  "scope": "source.c++",
  "files": {
    "extensions": ["C", "cc", "cp", "cpp", "cxx", "c++", "hh", "hpp", "hxx", "h++"]
  },
  "comments": {
    "line": "//",
    "block": ["/*", "*/"]
  },
  "syntax": "builtin:C++",
  "tree_sitter": {
    "grammar": "builtin:cpp",
    "highlights": ["builtin:c/highlights", "builtin:cpp/highlights"]
  },
  "lsp": {
    "language_id": "cpp",
    "server": "clangd",
    "command": ["clangd"],
    "initialization_options": {},
    "root_markers": ["compile_commands.json", "compile_flags.txt", "CMakeLists.txt", "meson.build", "Makefile"]
  }
}
