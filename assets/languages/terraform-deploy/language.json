{
  "schema": 1,
  "id": "terraform-deploy",
  "name": "HCL",
  "hidden": true,
  "scope": "source.hcl",
  "files": {
    "extensions": ["tfdeploy.hcl"],
    "names": [".tfdeploy.hcl"]
  },
  "comments": {
    "line": "#",
    "block": ["/*", "*/"]
  },
  "tree_sitter": {
    "grammar": "builtin:hcl",
    "highlights": ["builtin:hcl/highlights"]
  },
  "lsp": {
    "language_id": "terraform-deploy",
    "server": "terraform",
    "command": ["terraform-ls", "serve"],
    "initialization_options": {},
    "root_markers": [".terraform.lock.hcl", "main.tf", "terraform.tf"]
  }
}
