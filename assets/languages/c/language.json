{
  "schema": 1,
  "id": "c",
  "name": "C",
  "scope": "source.c",
  "files": {
    "extensions": ["c", "h"]
  },
  "comments": {
    "line": "//",
    "block": ["/*", "*/"]
  },
  "syntax": "builtin:C",
  "tree_sitter": {
    "grammar": "builtin:c",
    "highlights": ["builtin:c/highlights"]
  },
  "lsp": {
    "language_id": "c",
    "server": "clangd",
    "command": ["clangd"],
    "initialization_options": {},
    "root_markers": ["compile_commands.json", "compile_flags.txt", "CMakeLists.txt", "meson.build", "Makefile"]
  }
}
