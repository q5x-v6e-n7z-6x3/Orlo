{
  "schema": 1,
  "id": "rux",
  "name": "Rux",
  "scope": "source.rux",
  "files": { "extensions": ["rux"], "content": "\\A\\s*(?:[^<\\s]|\\z)" },
  "comments": { "line": "//", "block": ["/*", "*/"] },
