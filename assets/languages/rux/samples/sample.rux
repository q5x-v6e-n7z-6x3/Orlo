// Shapes, their areas, and a counter.
/* block comment /* nested */ still a comment */
/** Documentation block. */

import Core::{ PrintLine, Panic };

/// A shape with an area.
pub interface Shape {
    func Area(&self) -> float64;
}

pub struct Circle {
    radius: float64,
}

pub variant Outline {
    Filled(uint8),
    Dashed { length: uint32, gap: uint32 },
}

pub enum Color { Red, Green, Blue }

type Score = int32;

extend Circle : Shape {
    func Area(&self) -> float64 {
        return 3.141_592e0 * self.radius * self.radius;
    }
}

const Limit: uint = 100;
thread var Seen: uint64 = 0x10u64;

#NoReturn
func Stop(message: char8[..]) {
    Panic(message);
}

func Parse(text: char8[..]) -> int32 throws ParseError {
    let value: int32? = none;
    if text.length == 0 { throw .Empty; }
    defer { Seen++; }
    return value ?? 0b1010_1010i32;
}

pub func Main() -> int {
    let tab = '\t';
    let wide = c32"wide \u{1F600}";
    let pair = (1, 2.5f32);
    var total: float80 = pair.0 as float80;
    for i in 0..Limit {
        when #target.arch {
            .X86_64 => total += 1.0,
            _ => total -= 0o17 as float80,
        }
        if i is .Some(n) && sizeof(Circle) > alignof(uint8) { continue; }
    }
    let score: Score = try Parse("42\n") catch { e => -1 };
    match score {
        0 => PrintLine("zero {}", tab),
        _ => PrintLine("{score}"),
    }
    loop { break; }
    while false { unsafe { Stop(wide); } }
    return 0;
}
