%YAML 1.2
---
# A starting point: rename it, set `scope` to the manifest's, and replace the contexts. Leave out
# file_extensions; language.json decides which files are this language.
name: Example Language
scope: source.example-language
version: 2

contexts:
  main:
    - match: '#'
      scope: punctuation.definition.comment.example-language
      push: comment
    - match: '"'
      scope: punctuation.definition.string.begin.example-language
      push: string
    - match: '\b(?:if|else|while|return)\b'
      scope: keyword.control.example-language
    - match: '\b[0-9]+(?:\.[0-9]+)?\b'
      scope: constant.numeric.example-language
    - match: '\b(fn)\s+([A-Za-z_][A-Za-z0-9_]*)'
      captures:
        1: storage.type.function.example-language
        2: entity.name.function.example-language

  comment:
    - meta_scope: comment.line.number-sign.example-language
    - match: $\n?
      pop: true

  string:
    - meta_scope: string.quoted.double.example-language
    - match: '\\.'
      scope: constant.character.escape.example-language
    - match: '"'
      scope: punctuation.definition.string.end.example-language
      pop: true
